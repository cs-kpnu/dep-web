{
    "key": "group_homepage_fields",
    "title": "Home Page Settings",
    "fields": [
        {
            "key": "field_homepage_mission_desc",
            "label": "Mission Description",
            "name": "mission_desc",
            "type": "textarea",
            "instructions": "Text shown in the Mission section on the homepage.",
            "required": 0,
            "rows": 4,
            "wrapper": { "width": "", "class": "", "id": "" }
        },
        {
            "key": "field_homepage_statistic",
            "label": "Statistics",
            "name": "statistic",
            "type": "group",
            "layout": "block",
            "sub_fields": [
                {
                    "key": "field_stat_members",
                    "label": "Active Members",
                    "name": "members",
                    "type": "number",
                    "instructions": "Number shown in the Results section.",
                    "default_value": 20,
                    "min": 0,
                    "required": 0,
                    "wrapper": { "width": "25", "class": "", "id": "" }
                },
                {
                    "key": "field_stat_projects",
                    "label": "Completed Projects",
                    "name": "projects",
                    "type": "number",
                    "default_value": 12,
                    "min": 0,
                    "required": 0,
                    "wrapper": { "width": "25", "class": "", "id": "" }
                },
                {
                    "key": "field_stat_years",
                    "label": "Years of Experience",
                    "name": "years",
                    "type": "number",
                    "default_value": 2,
                    "min": 0,
                    "required": 0,
                    "wrapper": { "width": "25", "class": "", "id": "" }
                },
                {
                    "key": "field_stat_partners",
                    "label": "Partners",
                    "name": "partners",
                    "type": "number",
                    "default_value": 3,
                    "min": 0,
                    "required": 0,
                    "wrapper": { "width": "25", "class": "", "id": "" }
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "post_type",
                "operator": "==",
                "value": "page"
            },
            {
                "param": "page_type",
                "operator": "==",
                "value": "front_page"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "hide_on_screen": "",
    "active": true,
    "description": "ACF fields for the home page: mission text and statistics counters."
}
